# FastAPI 앱 설정 예시 — 복사해서 .env 로 사용
APP_NAME=sodosiro-ETL
DEBUG=false

# 업무 DB (로컬 실행용 — 컨테이너는 docker/.env 의 TRAVEL_DB_URL 사용)
POSTGRESS_USERNAME=postgres
POSTGRESS_PASSWORD=
POSTGRESS_DATABASE=travel

# 공공데이터포털(data.go.kr) 일반 인증키(Decoding)
PUBLIC_DATA_API_KEY=
# 목록 API 페이지당 수집 건수 (기본값 500)
PUBLIC_DATA_PAGE_SIZE=500

# 이미지 누락 복구 DAG 한 번에 조회할 최대 contentId 수
IMAGE_RECOVERY_BATCH_LIMIT=300

# areaBasedList2 원천 CSV 스냅샷 경로 (로컬 기본값: data/travel/raw)
TRAVEL_SNAPSHOT_DIR=data/travel/raw

# OpenAI 키 (임베딩용, EMBEDDING_ENABLED=true 일 때만)
GV_API_KEY=

# ── 인기 관광지 트렌드 수집 (popular_spot_collection / popular_spot_decay DAG) ──
# 카카오 개발자 콘솔 → 앱 → 앱 키 → REST API 키 (OAuth KAKAO_CLIENT_ID 와 별개)
KAKAO_REST_API_KEY=

# 수집 파라미터 (기본값으로 운영 가능, 필요 시 재정의)
# TREND_MIN_FREQUENCY=3
# TREND_TOP_N=20
# 최신순 수집 페이지 설정: 기본값은 검색어·채널당 최대 100건(50건 × 2페이지)
# TREND_SEARCH_PAGE_SIZE=50
# TREND_SEARCH_MAX_PAGES=2
# TREND_SEARCH_RADIUS=30000
# TREND_CHANNEL_DIVERSITY_BONUS=1.3
# TREND_CITY_SLEEP_SEC=0.5
# 모든 카카오 API 호출 간 최소 간격 (0.2초 = 초당 최대 5회)
# TREND_KEYWORD_SLEEP_SEC=0.2

# 인기 장소 이미지 보강: 한 실행당 대상 수 / 티스토리 도메인별 최소 요청 간격(초)
# TREND_IMAGE_BATCH_LIMIT=50
# TREND_TISTORY_MIN_INTERVAL_SEC=3


# 감쇠 파라미터
# TREND_DECAY_THRESHOLD=0.01
# TREND_DECAY_ATTRACTION=0.85
# TREND_DECAY_RESTAURANT=0.70
# TREND_DECAY_CAFE=0.70
