AIRFLOW_UID=50000
# scheduler/webserver 로그 서버 인증에 사용하는 공통 키 (충분히 긴 랜덤값으로 교체)
AIRFLOW_WEBSERVER_SECRET_KEY=replace-with-a-long-random-secret

_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow

# Docker 네트워크의 PostgreSQL 서비스. 컨테이너 내부 포트(5432)를 사용한다.
AIRFLOW_DB_URL=postgresql+psycopg2://<user>:<password>@postgres:5432/airflow

_PIP_ADDITIONAL_REQUIREMENTS=

# ── 여행지 ETL (travel_etl) ──────────────────────────────
# 업무 DB (Airflow 메타 DB와 분리)
TRAVEL_DB_URL=postgresql://<user>:<password>@postgres:5432/travel

# 공공데이터포털(data.go.kr) 일반 인증키(Decoding)
PUBLIC_DATA_API_KEY=
# areaBasedList2 등 목록 API의 페이지당 수집 건수
PUBLIC_DATA_PAGE_SIZE=500

# 실행당 상세 보강 최대 건수
DETAIL_BATCH_LIMIT=300
IMAGE_RECOVERY_BATCH_LIMIT=300
# areaBasedList2 원천 CSV 스냅샷 저장 경로 (컨테이너 내부 공유 볼륨)
TRAVEL_SNAPSHOT_DIR=/data/travel/raw
# TourAPI 순간 요청 제한 방지 (초당 최대 1건)
API_MIN_INTERVAL_SEC=1.0

# 법정동 기준 강원특별자치도(51)와 18개 시군구
TRAVEL_LDONG_REGN_CODE=51
# 비우면 전체 콘텐츠 유형 수집. 예: 12를 지정하면 관광지만 수집
TRAVEL_CONTENT_TYPE_ID=

# 적재 완료 후 변경분을 통지할 Spring 서버 (AI 처리는 Spring 담당)
SPRING_BASE_URL=http://host.docker.internal:8081
# Spring INTERNAL_ETL_TOKEN과 동일한 값 (예: openssl rand -hex 32)
SPRING_INTERNAL_ETL_TOKEN=
# 테스트 중 임베딩 비용 방지: 한 DAG 실행에서 Spring에 통지할 최대 건수
SPRING_NOTIFY_LIMIT=10
